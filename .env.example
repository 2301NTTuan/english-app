DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/english_mastery_dev
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/english_mastery_test
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Production must use postgres; memory is available only for local/test isolation.
RATE_LIMIT_BACKEND=postgres
# Set true only when direct traffic is blocked and your reverse proxy overwrites client-IP headers.
TRUST_PROXY=false
SLOW_REQUEST_MS=1000
CONTENT_VERSION=bundled-v1
# Include validated content only for local, Preview, or public staging/dev deployments.
# Omit this variable from a true production launch so only published content is visible.
CONTENT_RELEASE_CHANNEL=validated-preview
# Outbound email: disabled, development (local-only links), or resend.
# Use development locally to get a non-secret verification URL in the response.
# For real delivery, use resend with an HTTPS APP_BASE_URL and a sender on a domain verified in Resend.
EMAIL_DELIVERY_PROVIDER=disabled
APP_BASE_URL=http://localhost:3000
EMAIL_FROM=English Mastery <verify@updates.your-domain.example>
# RESEND_API_KEY is required only when EMAIL_DELIVERY_PROVIDER=resend. Never commit a real value.
RESEND_API_KEY=
