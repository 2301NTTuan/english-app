DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/english_mastery_dev
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/english_mastery_test
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Production must use postgres; memory is available only for local/test isolation.
RATE_LIMIT_BACKEND=postgres
# Set true only when direct traffic is blocked and your reverse proxy overwrites client-IP headers.
TRUST_PROXY=false
SLOW_REQUEST_MS=1000
CONTENT_VERSION=bundled-v1
# Outbound email: disabled, development (local-only links), or resend.
EMAIL_DELIVERY_PROVIDER=disabled
APP_BASE_URL=http://localhost:3000
EMAIL_FROM=English Mastery <no-reply@example.com>
# RESEND_API_KEY is required only when EMAIL_DELIVERY_PROVIDER=resend. Never commit a real value.
RESEND_API_KEY=
